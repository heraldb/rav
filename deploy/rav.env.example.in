# =============================================================================
# Rav — native deployment config (/etc/rav/rav.env)
# =============================================================================
# See .env.example in the repository for all options.

# Server: listen on loopback only, nginx proxies to it
HOST=127.0.0.1
PORT=${RAV_PORT}

# Anything other than "development" marks session cookies as Secure
ENVIRONMENT=production

STATIC_DIR=/opt/rav/static
DATA_DIR=/var/lib/rav

# Mail server (Dovecot/Postfix on this VPS)
# IMAP_HOST/SMTP_HOST must match the mail server's TLS certificate name; the
# *_CONNECT_HOST values are where the TCP connection actually goes.
IMAP_HOST=${RAV_MAIL_HOST}
IMAP_PORT=993
IMAP_CONNECT_HOST=127.0.0.1
SMTP_HOST=${RAV_MAIL_HOST}
SMTP_PORT=587
SMTP_CONNECT_HOST=127.0.0.1
TLS_ENABLED=true

# Only allow logins against the mail server configured above
ALLOW_CUSTOM_MAIL_SERVERS=false

# Push filter rules as Sieve scripts (ManageSieve). Rav speaks plain TCP to
# ManageSieve, so keep this on loopback.
# Note: saving filters in Rav uploads and activates a "rav-filters" script,
# which replaces the user's previously active script (e.g. Roundcube's).
SIEVE_HOST=127.0.0.1
SIEVE_PORT=4190

# Optional: spam/ham reporting to rspamd
# RSPAMD_URL=http://127.0.0.1:11334

# Reverse proxy: trust X-Real-IP / X-Forwarded-For from local nginx
TRUSTED_PROXIES=127.0.0.1/32

# Passkeys
WEBAUTHN_RP_ID=${RAV_DOMAIN}
WEBAUTHN_RP_ORIGIN=https://${RAV_DOMAIN}

SESSION_TIMEOUT_HOURS=24
RUST_LOG=info,tantivy=warn,async_imap=warn
