# Site-specific values for deploy/build-native.sh. Copy this file to
# deploy/site.env (gitignored) in the worktree you build from and fill it in.
# The build renders them into nginx-site.conf and rav.env.example, and ships
# site.env itself in the tarball for install.sh.

# Public host name of the webmail (nginx server_name, passkey RP ID)
RAV_DOMAIN=webmail.example.com

# Mail server name, must match its TLS certificate (IMAP_HOST/SMTP_HOST)
RAV_MAIL_HOST=mail.example.com

# Loopback port Rav listens on, nginx proxies to it
RAV_PORT=3015
